generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Shipment {
  id          String   @id @default(uuid()) @db.Uuid
  terminal    String   @db.VarChar(16)
  shippedAt   DateTime @map("shipped_at") @db.Timestamp(3)
  volume      Decimal  @db.Decimal(18, 3)
  destination String?  @db.VarChar(120)
  document    String?  @db.VarChar(64)
  notes       String?  @db.VarChar(255)
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  @@index([terminal, shippedAt])
  @@map("shipments")
}

model Record {
  id                         String   @id @default(uuid()) @db.Uuid
  dataHora                   DateTime @map("data_hora") @db.Timestamp(3)
  numeroNota                 String   @map("numero_nota") @db.VarChar(64)
  notaChave                  String?  @map("nota_chave") @db.VarChar(255)
  notaOriginal               String   @map("nota_original") @db.VarChar(255)
  notaPesagemId              String   @map("nota_pesagem_id") @db.VarChar(64)
  status                     String   @db.VarChar(64)
  emitenteCnpj               String?  @map("emitente_cnpj") @db.VarChar(32)
  emitenteFornecedor         String?  @map("emitente_fornecedor") @db.VarChar(120)
  motoristaNome              String?  @map("motorista_nome") @db.VarChar(120)
  motoristaCelular           String?  @map("motorista_celular") @db.VarChar(24)
  placa                      String   @db.VarChar(16)
  placaRecebimento           String?  @map("placa_recebimento") @db.VarChar(32)
  recebimentoColaborador     String?  @map("recebimento_colaborador") @db.VarChar(120)
  recebimentoPeso            String?  @map("recebimento_peso") @db.VarChar(32)
  recebimentoPatioDescarga   String?  @map("recebimento_patio_descarga") @db.VarChar(120)
  recebimentoData            String?  @map("recebimento_data") @db.VarChar(25)
  recebimentoPlaca           String?  @map("recebimento_placa") @db.VarChar(32)
  terminal                   String   @db.VarChar(120)
  createdAt                  DateTime @default(now()) @map("created_at")

  @@index([dataHora])
  @@index([status])
  @@index([motoristaNome])
  @@index([placa])
  @@index([terminal])
  @@map("records")
}


model Note {
  id        String   @id @default(uuid()) @db.Uuid
  codigo    String   @unique @db.VarChar(44)
  terminal  String   @db.VarChar(120)
  dataHora                   DateTime? @map("data_hora") @db.Timestamp(3)
  numero                     String?  @db.VarChar(64)
  original                   String?  @db.VarChar(255)
  status                     String   @db.VarChar(64)
  emitenteCnpj               String?  @map("emitente_cnpj") @db.VarChar(32)
  emitenteFornecedor         String?  @map("emitente_fornecedor") @db.VarChar(120)
  placa                      String?  @db.VarChar(16)
  motoristaNome              String?  @map("motorista_nome") @db.VarChar(120)
  motoristaTelefone          String?  @map("motorista_telefone") @db.VarChar(24)
  recebimentoColaborador     String?  @map("recebimento_colaborador") @db.VarChar(120)
  recebimentoPeso            String?  @map("recebimento_peso") @db.VarChar(32)
  recebimentoPatioDescarga   String?  @map("recebimento_patio_descarga") @db.VarChar(120)
  recebimentoData            String?  @map("recebimento_data") @db.VarChar(25)
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@index([dataHora])
  @@index([status])
  @@index([terminal])
  @@index([placa])
  @@index([motoristaNome])
  @@map("notes")
}

model Material {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  @@map("materials")
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  @@map("suppliers")
}

model PurchaseOrderRule {
  id                String   @id @default(uuid()) @db.Uuid
  materialId        String   @map("material_id") @db.VarChar(64)
  supplierId        String   @map("supplier_id") @db.VarChar(64)
  purchaseOrderCode String   @map("purchase_order_code") @db.VarChar(64)
  purchaseOrderType String   @map("purchase_order_type") @db.VarChar(32)
  description       String?  @db.VarChar(255)
  lot               String?  @db.VarChar(64)
  minimumQuantity   Decimal? @map("minimum_quantity") @db.Decimal(18, 4)
  costCenter        String?  @map("cost_center") @db.VarChar(64)
  paymentCondition  String?  @map("payment_condition") @db.VarChar(64)
  currency          String?  @db.VarChar(16)
  unit              String?  @db.VarChar(16)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamp(3)
  createdBy         String   @map("created_by") @db.Uuid
  updatedBy         String   @map("updated_by") @db.Uuid
  histories         PurchaseOrderRuleHistory[]

  @@unique([materialId, supplierId, isActive], map: "purchase_order_rules_material_supplier_active_key")
  @@index([materialId])
  @@index([supplierId])
  @@map("purchase_order_rules")
}

model PurchaseOrderRuleHistory {
  id                  String             @id @default(uuid()) @db.Uuid
  purchaseOrderRuleId String             @map("purchase_order_rule_id") @db.Uuid
  purchaseOrderRule   PurchaseOrderRule  @relation(fields: [purchaseOrderRuleId], references: [id])
  action              String             @db.VarChar(16)
  userId              String             @map("user_id") @db.Uuid
  beforeData          Json?              @map("before_data") @db.JsonB
  afterData           Json?              @map("after_data") @db.JsonB
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamp(3)

  @@index([purchaseOrderRuleId])
  @@map("purchase_order_rule_histories")
}
